# ─────────────────────────────────────────────────────────────────────────────
# WorkIQ Frontend – environment variables
# Copy to .env.local and fill in your values (never commit .env.local).
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL.
# Local dev:   http://localhost:8000
# Production:  https://api.contoso.com
VITE_BACKEND_URL=http://localhost:8000

# No Azure credentials needed here — the frontend never touches tokens.
# All authentication is handled by the Python backend (confidential client).
