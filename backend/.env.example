# ─────────────────────────────────────────────────────────────────────────────
# WorkIQ Backend – environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Entra ID ────────────────────────────────────────────────────────────
# Your Azure tenant (directory) ID
TENANT_ID=2a57864c-da2a-4a44-953c-9781f73f880a

# App registration Client ID.
# The same registration is used by the frontend SPA and by the backend for OBO.
CLIENT_ID=5479e21b-7514-440d-abe6-25cb5e6d9ce3

# Client secret generated in "Certificates & secrets" for the app registration.
# Only the backend uses this – never expose it to the frontend.
CLIENT_SECRET=F1z8Q~FnqYIgBNPwBWIHq6B9tGciQQc-3THYZbKU

# Session signing key — used by Starlette SessionMiddleware to sign cookies.
# Generate a new value with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this value invalidates all active user sessions.
SECRET_KEY=6fabeca782f9c5c5e9d6c6a7c2e284b72986923c95d81912ba62ad1652c8972d

# ── Token audience (optional) ─────────────────────────────────────────────────
# The backend validates that incoming tokens are issued for this audience.
# Defaults to  api://<CLIENT_ID>  if not set.
# Override only if you configured a custom Application ID URI.
# API_AUDIENCE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production replace with your Container App / Static Web App URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
# Set to true to enable /docs and verbose logging during development.
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# Azure App Registration setup checklist
# ─────────────────────────────────────────────────────────────────────────────
# 1. Register an app in Entra ID (portal.azure.com → Entra ID → App registrations)
# 2. Platform:  Web  (NOT Single-page application)
#    Redirect URI:  http://localhost:8000/auth/callback
#    Implicit grant (ID tokens / Access tokens):  both OFF
# 3. API permissions (delegated):
#    - Microsoft Graph: Sites.Read.All
#    - Microsoft Graph: Mail.Read
#    - Microsoft Graph: People.Read.All
#    - Microsoft Graph: OnlineMeetingTranscript.Read.All
#    - Microsoft Graph: Chat.Read
#    - Microsoft Graph: ChannelMessage.Read.All
#    - Microsoft Graph: ExternalItem.Read.All
# 4. Grant admin consent for all the above permissions.
# 5. Certificates & secrets → New client secret → copy value to CLIENT_SECRET.
# 6. Users must have a Microsoft 365 Copilot add-on license.
#
# Note: "Expose an API" / api:// scope is NOT required. WorkIQ uses the
# confidential-client auth-code flow — tokens are held server-side and the
# frontend communicates via a signed session cookie, not Bearer tokens.