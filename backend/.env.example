# ─────────────────────────────────────────────────────────────────────────────
# WorkIQ Backend – environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Entra ID ────────────────────────────────────────────────────────────
# Your Azure tenant (directory) ID
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# App registration Client ID
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret from "Certificates & secrets" in the app registration.
# The backend uses this to exchange the auth code for tokens — it never
# reaches the browser.
CLIENT_SECRET=your_client_secret_here

# ── Session ───────────────────────────────────────────────────────────────────
# Random secret used to sign session cookies.  Changing this invalidates
# all existing sessions.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Or run Setup-AppRegistration.ps1 -WriteEnvFiles which generates it for you.
SECRET_KEY=your_random_secret_key_here

# ── OAuth redirect ────────────────────────────────────────────────────────────
# Where Microsoft sends the auth code after the user signs in.
# Must EXACTLY match the redirect URI registered in Entra ID (Web platform).
# Local:      http://localhost:8000/auth/callback
# Production: https://api.contoso.com/auth/callback
REDIRECT_URI=http://localhost:8000/auth/callback

# URL the backend redirects the browser to after a successful sign-in.
FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Must use explicit origins (not *) because credentials (cookies) are sent.
ALLOWED_ORIGINS=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# Azure App Registration setup checklist
# ─────────────────────────────────────────────────────────────────────────────
# Run  infra/Setup-AppRegistration.ps1 -WriteEnvFiles  to do all of this
# automatically.  Manual steps if preferred:
#
# 1. Register an app in Entra ID (portal.azure.com → Entra ID → App registrations)
# 2. Platform: Web  (NOT Single-page application)
#    Redirect URI: http://localhost:8000/auth/callback
#    (add https://api.yourdomain.com/auth/callback for production)
#    Implicit grant: leave BOTH id-token and access-token checkboxes OFF
# 3. API permissions (Delegated, Microsoft Graph):
#    - Sites.Read.All
#    - Mail.Read
#    - People.Read.All
#    - OnlineMeetingTranscript.Read.All
#    - Chat.Read
#    - ChannelMessage.Read.All
#    - ExternalItem.Read.All
# 4. Grant admin consent for all the above permissions.
# 5. Certificates & secrets → New client secret → copy value to CLIENT_SECRET.
# 6. Users must have a Microsoft 365 Copilot add-on license.
